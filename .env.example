# 复制这个文件为 .env 再填上你自己的值：  cp .env.example .env
# 真实 .env 已被 .gitignore 忽略，不会被提交。

# ===== 运行环境 =====
ENVIRONMENT=prod
# 反向 WS 必须用 ReverseDriver（fastapi 属于这一类）
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# ===== 连接 NapCat（OneBot V11）=====
# 必须与 NapCat「网络配置 → WebSocket 客户端」里的 token 一致
ONEBOT_ACCESS_TOKEN=change-me-to-a-random-token

# 超级用户（你自己的 QQ 号），管理类命令用
SUPERUSERS=["你的QQ号"]

# ===== 文本对话 / 看图（/ds、/imgds）=====
# 填上你自己的服务地址与 key
WB_BASE_URL=https://your-api.example/v1
WB_DS_KEY=
WB_SYSTEM=你是一个 QQ 聊天机器人，用中文回复，语气自然简洁，别太啰嗦。
